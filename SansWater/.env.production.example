# Vercel Settings > Environment Variables, Production scope.
# Never prefix these variables with VITE_. Do not commit real secrets.
NODE_ENV=production
DATA_PROVIDER=supabase
DATABASE_URL=postgresql://depot_runtime.PROJECT_REF:PASSWORD_URL_ENCODED@HOST_POOLER:6543/postgres
# Supabase Connect > Transaction pooler, IPv4 port 6543; backend role, not postgres.
APP_ORIGIN=https://sanswater.vercel.app
SECURE_COOKIE=true
AUTH_PROVIDER=local
PHOTO_STORAGE=gas
GAS_PHOTO_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_PHOTO_SECRET=GANTI_DENGAN_64_KARAKTER_HEX_YANG_SUDAH_ADA
# Private temporary cache, isolated per instance; 0 disables it. Maximum 128 MiB.
PHOTO_CACHE_MAX_MB=96
# API Preview is disabled. Enable only with a SEPARATE test database and its own
# exact APP_ORIGIN; never share the production database with branch previews.
# ALLOW_PREVIEW_DATABASE=true
